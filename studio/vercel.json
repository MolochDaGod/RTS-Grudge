{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm install --legacy-peer-deps && BASE_PATH=/ npm run build",
  "outputDirectory": "dist/public",
  "framework": null,
  "alias": ["forge.grudge-studio.com"],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.grudge-studio.com/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://id.grudge-studio.com/auth/:path*" },
    { "source": "/assets-cdn/:path*", "destination": "https://assets.grudge-studio.com/:path*" },
    { "source": "/objectstore/:path*", "destination": "https://objectstore.grudge-studio.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.grudge-studio.com https://grudgewarlords.com https://*.vercel.app"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}