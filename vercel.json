{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "cross-env SKIP_FORGE_BUILD=1 npm run build",
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/:path((?!forge|api|socket\\.io|Models|assets).*)",
      "destination": "/forge/:path*",
      "has": [{ "type": "host", "value": "forge.grudge-studio.com" }]
    },
    {
      "source": "/api/island/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/island/:path*"
    },
    {
      "source": "/api/island",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/island"
    },
    {
      "source": "/api/islands/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/islands/:path*"
    },
    {
      "source": "/api/account/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/account/:path*"
    },
    {
      "source": "/api/account",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/account"
    },
    {
      "source": "/api/characters/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/characters/:path*"
    },
    {
      "source": "/api/characters",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/characters"
    },
    {
      "source": "/api/island-nfts/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/island-nfts/:path*"
    },
    {
      "source": "/api/island-nfts",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/island-nfts"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "https://id.grudge-studio.com/api/auth/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://id.grudge-studio.com/auth/:path*"
    },
    {
      "source": "/login",
      "destination": "https://id.grudge-studio.com/login"
    },
    {
      "source": "/api/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://grudge-api-production-0d46.up.railway.app/socket.io/:path*"
    },
    {
      "source": "/Models/:path*",
      "destination": "https://assets.grudge-studio.com/models/:path*"
    },
    {
      "source": "/forge",
      "destination": "/forge/"
    },
    {
      "source": "/forge/:path*",
      "destination": "/forge/index.html"
    },
    {
      "source": "/((?!api|socket\\.io|Models|assets|forge).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://id.grudge-studio.com https://*.grudge-studio.com https://ws.grudge-studio.com"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/forge/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/forge/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
